# Environment configuration example for Hall of Achievements (Milestone 1)
# Copy this file to .env.local for local development. Never commit real secrets!

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hall_of_achievements

# Minimum 128 bits entropy (>= 32 characters)
OWNER_ACCESS_CODE=example_owner_access_code_must_be_at_least_32_characters_long

# Minimum 256 bits entropy (>= 64 hex characters)
SESSION_VERSION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Minimum 128 bits entropy (>= 32 characters)
RATE_LIMIT_SALT=example_rate_limit_salt_must_be_at_least_32_characters_long

# Canonical Origin for CSRF / Origin header checks
APP_ORIGIN=http://localhost:3000
